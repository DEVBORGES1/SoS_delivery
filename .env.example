# Copie para .env e preencha com os dados do seu projeto no Supabase
# (Project Settings → API). Sem estas variáveis, o site usa os dados do código.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Chave "anon public" (ou "publishable"). É pública por natureza: quem protege o
# banco são as regras de segurança do supabase/schema.sql. Nunca use a service_role.
VITE_SUPABASE_ANON_KEY=
